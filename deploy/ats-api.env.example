# Copy to /etc/staffcore33/ats-api.env and chmod 600
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080
DB_URL=jdbc:postgresql://127.0.0.1:5432/staffcore33_ats
DB_USER=staffcore
DB_PASSWORD=CHANGE_ME
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
JWT_EXPIRATION_MS=86400000
CORS_ORIGINS=https://ats.staffcore33.com
FILE_UPLOAD_DIR=/var/staffcore33/uploads
